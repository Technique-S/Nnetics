# Copy to .env.local; never commit private credentials. All accounts must be testnet.
# Application access derives ownership from the configured vault, never an owner ID.
NNETICS_NETWORK=testnet
NNETICS_ORGANIZATION_ID=
NNETICS_VAULT_ID=
NNETICS_WORKER_ID=
NNETICS_VENDOR_ID=
NNETICS_RPC_URL=https://test.rpc.fastnear.com
NNETICS_APP_ORIGIN=http://127.0.0.1:3100
NNETICS_EXPECTED_CODE_HASH=
NNETICS_WORKER_PUBLIC_KEY=
NNETICS_DATABASE=../../artifacts/live/invoices.db
# Wallet identity and organization onboarding do not require the vault database.
NNETICS_IDENTITY_DATABASE=../../artifacts/live/identities.db
NNETICS_VENDOR_IDS=
NNETICS_ORDER_IDS=
# Leave unset until the human authorizes the exact account/transaction plan.
NNETICS_TRANSACTIONS_AUTHORIZED=
NNETICS_WORKER_KEY_FILE=
# Setup scripts only: public keys installed at account creation. Keep vault key separate.
NNETICS_OWNER_ID=
NNETICS_OWNER_PUBLIC_KEY=
NNETICS_VAULT_PUBLIC_KEY=
NNETICS_VENDOR_PUBLIC_KEY=
NNETICS_WASM_PATH=../../artifacts/vault.wasm
# Execution is opt-in per step and exact reviewed plan digest, not a blanket deploy switch.
NNETICS_DEPLOYMENT_APPROVED_PLAN_SHA256=
NNETICS_SETUP_KEY_FILE=
# Optional alternative: installed near-cli-rs 0.30.1 native executable, secure keychain.
# Set exactly one setup signer; the CLI path is only used by explicit setup commands.
NNETICS_SETUP_KEYCHAIN_CLI=
# Self-service provisioning is separate from payment/worker authorization.
# These must pin newly verified Linux artifacts, not the old deployed vault.
NNETICS_FACTORY_ID=
NNETICS_FACTORY_CODE_HASH=
NNETICS_PROVISIONING_VAULT_CODE_HASH=
# Leave blank until factory deployment/review and exact testnet plans are approved.
NNETICS_PROVISIONING_ENABLED=
# Persistent private contractor billing, separate from demo fixtures and payment queue.
# Store this SQLite file on persistent local storage. No live payouts are enabled.
NNETICS_CONTRACTOR_DATABASE=../../artifacts/live/contractors.db
# Server-only optional extraction. Never use NEXT_PUBLIC_ for this key.
OPENROUTER_API_KEY=
NNETICS_AI_MODEL=nvidia/nemotron-3.5-super-vl:free
