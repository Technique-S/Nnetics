{
  "name": "nnetics-owner-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "worker": "node --env-file-if-exists=.env.local src/server/worker-cli.ts",
    "testnet:plan": "node --env-file-if-exists=.env.local scripts/testnet-plan.ts",
    "testnet:keys": "node --env-file-if-exists=.env.local scripts/testnet-keys.ts",
    "testnet:execute": "node --env-file-if-exists=.env.local scripts/testnet-execute.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/nightly": "10.1.4",
    "buffer": "6.0.3",
    "near-api-js": "7.4.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
