  "requirements": [
    {
      "id": "SAFETY.001",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not delete either source branch before successful consolidation and verification."
    },
    {
      "id": "SAFETY.002",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not force-push, reset shared branches, rewrite public history, or delete remote branches without explicit approval."
    },
    {
      "id": "SAFETY.003",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not overwrite newer working functionality with older implementations."
    },
    {
      "id": "SAFETY.004",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not remove code based solely on filenames, modification dates, or apparent inactivity."
    },
    {
      "id": "SAFETY.005",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not delete tests because they currently fail."
    },
    {
      "id": "SAFETY.006",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not delete security checks, permission boundaries, or authorization logic to simplify the demo."
    },
    {
      "id": "SAFETY.007",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not modify deployed NEAR contract state, initiate payments, or execute blockchain transactions."
    },
    {
      "id": "SAFETY.008",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Preserve production and testnet contract interfaces unless a change is necessary and explicitly approved."
    },
    {
      "id": "SAFETY.009",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Do not expose wallet credentials, private keys, environment secrets, or API keys."
    },
    {
      "id": "SAFETY.010",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Preserve existing user data, migrations, invoice records, and backend persistence behavior."
    },
    {
      "id": "SAFETY.011",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Never claim a feature works unless its behavior has been verified."
    },
    {
      "id": "SAFETY.012",
      "phase": "SAFETY",
      "section": "Non-negotiable safety",
      "criterion": "Keep all consolidation work on a dedicated working branch until acceptance checks pass."
    },
